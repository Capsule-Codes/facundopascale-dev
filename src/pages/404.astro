---
// 404 — locale from the requested path.
//
// Under `output: 'static'` this page is prerendered ONCE at build time and the
// host serves it for every unknown URL, so the build cannot know the locale.
// We render ES (the default locale, correct `lang` out of the box) and a tiny
// `is:inline` script swaps title, subtitle, home link and `<html lang>` to EN
// when the requested path starts with `/en/` (or is `/en`). Any other path
// stays in Spanish.
//
// Why NOT per-locale 404s (`/es/404.astro` + `/en/404.astro`): Vercel's static
// adapter only routes unknown paths to the single top-level 404.html
// (`node_modules/@astrojs/vercel/dist/index.js` looks up `pathname === "/404"`).

import Layout from '../components/Layout.astro';

const title = 'Página no encontrada';
const description = 'La página que estás buscando no existe o se movió de lugar.';
---

<Layout title={`404 — ${title}`} description={description} locale="es">
  <div class="mx-auto max-w-2xl px-6 py-32 text-center">
    <p class="font-mono text-xs text-[var(--color-accent)] mb-4">// 404</p>
    <h1 id="fp-404-title" class="text-6xl font-display mb-4">Página no encontrada</h1>
    <p id="fp-404-sub" class="text-[var(--color-text-muted)] mb-8">Se fue de viaje y no volvió.</p>
    <a
      id="fp-404-home"
      href="/es/"
      class="font-mono text-sm text-[var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
    >
      → Volver al home
    </a>
  </div>
  <script is:inline>
    (function () {
      try {
        const path = location.pathname.toLowerCase();
        if (path !== '/en' && !path.startsWith('/en/')) return;
        document.documentElement.lang = 'en';
        const t = document.getElementById('fp-404-title');
        const s = document.getElementById('fp-404-sub');
        const h = document.getElementById('fp-404-home');
        if (t) t.textContent = 'Page not found';
        if (s) s.textContent = 'It went on a trip and never came back.';
        if (h) {
          h.setAttribute('href', '/en/');
          h.textContent = '\u2192 Back to home';
        }
        const titleEl = document.querySelector('title');
        if (titleEl) titleEl.textContent = '404 — Page not found';
      } catch {
        /* ignore: location unavailable */
      }
    })();
  </script>
</Layout>
