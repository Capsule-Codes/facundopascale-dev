---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { handleChangePassword, type PasswordField } from '../../lib/admin-password';

export const prerender = false;

const supabase = Astro.locals.supabase!;
const user = Astro.locals.user!;

let errors: Partial<Record<PasswordField, string>> = {};
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  try {
    const result = await handleChangePassword(supabase, user, await Astro.request.formData());
    if (result.ok) return Astro.redirect('/admin/password?saved=updated', 303);
    ({ errors } = result);
    notice = result.notice ?? null;
    Astro.response.status = result.notice ? 500 : 400;
  } catch {
    // Never log the cause: it may carry request details.
    Astro.response.status = 500;
    notice = 'Could not update your password. Please try again.';
  }
}

const saved = { updated: 'Password updated.' }[Astro.url.searchParams.get('saved') ?? ''];
const fields = [
  ['current_password', 'Current password', 'current-password'],
  ['new_password', 'New password', 'new-password'],
  ['confirm_password', 'Confirm new password', 'new-password'],
] as const;
---

<AdminLayout title="Password">
  <h1>Password</h1>
  {
    saved && (
      <p class="admin-notice" role="status">
        {saved}
      </p>
    )
  }
  {
    notice && (
      <p class="admin-error" role="alert">
        {notice}
      </p>
    )
  }

  <form method="post" action="/admin/password" novalidate>
    {
      fields.map(([name, text, autocomplete]) => (
        <div class="admin-field">
          <label for={name}>{text}</label>
          <input
            id={name}
            name={name}
            type="password"
            autocomplete={autocomplete}
            required
            aria-invalid={errors[name] ? 'true' : undefined}
            aria-describedby={errors[name] ? `${name}-error` : undefined}
          />
          {errors[name] && (
            <p class="admin-field-error" id={`${name}-error`}>
              {errors[name]}
            </p>
          )}
        </div>
      ))
    }
    <p class="admin-muted">Use 12 to 72 characters.</p>
    <button class="admin-button" type="submit">Update password</button>
  </form>
</AdminLayout>
