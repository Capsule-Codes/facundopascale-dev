---
import { getCollection, render } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import PostMeta from '../../../components/PostMeta.astro';
import Toc from '../../../components/Toc.astro';
import { filterPublished, byLocale } from '../../../lib/content';
import { type Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const all = await getCollection('blog');
  const paths = [];
  for (const loc of ['es', 'en'] as const) {
    const published = filterPublished(byLocale(all, loc));
    for (const entry of published) {
      const slug = entry.id.replace(`${loc}/`, '').replace(/\.mdx$/, '');
      paths.push({ params: { locale: loc, slug }, props: { entry } });
    }
  }
  return paths;
}

const { locale } = Astro.params;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const loc = locale as Locale;
// readingTime is attached by the remark plugin at build time but NOT in the Zod schema,
// so it lives on the frontmatter output. We read it defensively here.
const rt = (entry.data as unknown as { readingTime?: number }).readingTime;
---

<Layout
  title={`${entry.data.title} — Facundo Pascale`}
  description={entry.data.description}
  locale={loc}
  currentDocId={entry.id}
  currentCollection="blog"
>
  <div class="mx-auto max-w-3xl px-6 py-24">
    <Toc headings={headings} locale={loc} />
    <article>
      <h1 class="text-4xl md:text-5xl font-display mb-4">{entry.data.title}</h1>
      <PostMeta
        locale={loc}
        publishedAt={entry.data.publishedAt}
        updatedAt={entry.data.updatedAt}
        readingTime={rt}
        tags={entry.data.tags}
      />
      <div class="prose dark:prose-invert max-w-none mt-12">
        <Content />
      </div>
    </article>
  </div>
</Layout>
