---
import { getCollection } from 'astro:content';
import WorkDetail from '../../../components/WorkDetail.astro';
import { byLocale } from '../../../lib/content';

export async function getStaticPaths() {
  const all = byLocale(await getCollection('work'), 'en');
  return all.map((entry) => ({
    params: {
      locale: 'en',
      slug: entry.id.replace('en/', '').replace(/\.mdx$/, ''),
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<WorkDetail entry={entry} locale="en" />
