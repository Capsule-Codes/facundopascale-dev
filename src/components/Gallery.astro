---
import { Image } from 'astro:assets';
import { resolveGalleryItem, type GalleryEntry } from '../lib/gallery';
import type { Locale } from '../lib/i18n';

interface Props {
  items: GalleryEntry[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const images = items.map(resolveGalleryItem);
// Rendered widths: the article is max-w-3xl (768px) with 24px gutters and the figure frame adds
// 18px (p-2 + border). Desktop shots span both grid columns, phone shots take one.
const DESKTOP_WIDTHS = [480, 640, 750, 960, 1200, 1440];
const DESKTOP_SIZES = '(min-width: 768px) 702px, calc(100vw - 66px)';
const PHONE_WIDTHS = [320, 480, 640, 750];
const PHONE_SIZES = '(min-width: 768px) 334px, calc(50vw - 50px)';
const heading = locale === 'es' ? 'Galería' : 'Gallery';
---

{
  images.length > 0 && (
    <section id="gallery" aria-labelledby="gallery-heading" class="mt-16">
      <p class="font-mono text-xs text-[var(--color-accent)] mb-2">// {images.length} img</p>
      <h2 id="gallery-heading" class="text-3xl font-display mb-6">
        {heading}
      </h2>
      <ul class="grid grid-cols-2 gap-4 items-start list-none p-0 m-0">
        {images.map((img) => (
          <li class={img.kind === 'desktop' ? 'col-span-2' : 'col-span-1 sm:col-span-1'}>
            <figure class="m-0 border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-2">
              <Image
                src={img.src}
                alt={img.alt}
                width={img.width}
                height={img.height}
                widths={img.kind === 'desktop' ? DESKTOP_WIDTHS : PHONE_WIDTHS}
                sizes={img.kind === 'desktop' ? DESKTOP_SIZES : PHONE_SIZES}
                quality={75}
                loading="lazy"
                decoding="async"
                class="block w-full h-auto"
              />
              {img.caption && (
                <figcaption class="mt-2 font-mono text-xs text-[var(--color-text-dim)]">
                  {img.caption}
                </figcaption>
              )}
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}
