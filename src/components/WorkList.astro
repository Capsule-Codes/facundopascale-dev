---
import { getCollection } from 'astro:content';
import Layout from './Layout.astro';
import ShowcaseCard from './ShowcaseCard.astro';
import { byLocale } from '../lib/content';
import { findCaseStudy, unmatchedCaseStudies } from '../lib/case-studies';
import { localizedPath, type Locale } from '../lib/i18n';
import { getShowcase, getSiteSettings } from '../lib/site-data';

interface Props {
  locale: Locale;
}

const loc = Astro.props.locale;

const [showcase, settings, work] = await Promise.all([
  getShowcase(loc),
  getSiteSettings(loc),
  getCollection('work'),
]);

const studies = byLocale(work, loc)
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({
    slug: e.id.replace(`${loc}/`, '').replace(/\.mdx$/, ''),
    title: e.data.title,
    tagline: e.data.tagline,
  }));

const highlighted = showcase.filter((p) => p.highlighted);
const more = showcase.filter((p) => !p.highlighted);
const leftover = unmatchedCaseStudies(
  showcase.map((p) => p.title),
  studies
);

const contactHref = settings.email ? `mailto:${settings.email}` : localizedPath('contact', loc);

const copy = {
  es: {
    title: 'Trabajo — Facundo Pascale',
    description:
      'Apps móviles y web que Capsule Codes ha construido para startups: proyectos destacados y casos de estudio.',
    plate: 'LÁMINA A · TRABAJO',
    h1Before: 'Lo que hemos ',
    h1Accent: 'construido.',
    intro:
      'Capsule Codes construye apps móviles y web para startups. Estos son proyectos reales, con sus enlaces para verlos funcionando.',
    highlighted: 'Destacados',
    more: 'Más proyectos',
    caseStudy: 'Caso de estudio',
    studiesPlate: 'CASOS DE ESTUDIO',
    studiesTitle: 'Casos de estudio',
    empty: 'Pronto habrá proyectos aquí.',
    contactPlate: 'LÁMINA D · CONTACTO',
    contactBefore: '¿Tienes un proyecto? ',
    contactAccent: 'Dibujémoslo.',
    cta: 'Agendar una call',
    live: 'Sitio web',
    appStore: 'App Store',
    playStore: 'Google Play',
  },
  en: {
    title: 'Work — Facundo Pascale',
    description:
      'Mobile and web apps Capsule Codes has built for startups: highlighted projects and case studies.',
    plate: 'SHEET A · WORK',
    h1Before: 'What we have ',
    h1Accent: 'built.',
    intro:
      'Capsule Codes builds mobile and web apps for startups. These are real projects, with links to see them running.',
    highlighted: 'Highlighted',
    more: 'More projects',
    caseStudy: 'Case study',
    studiesPlate: 'CASE STUDIES',
    studiesTitle: 'Case studies',
    empty: 'Projects coming soon.',
    contactPlate: 'SHEET D · CONTACT',
    contactBefore: 'Got a project? ',
    contactAccent: "Let's draw it.",
    cta: 'Book a call',
    live: 'Website',
    appStore: 'App Store',
    playStore: 'Google Play',
  },
}[loc];

const linkLabels = { live: copy.live, appStore: copy.appStore, playStore: copy.playStore };
const caseStudyFor = (title: string) => {
  const match = findCaseStudy(title, studies);
  return match
    ? { href: localizedPath('work', loc, match.slug), label: copy.caseStudy }
    : undefined;
};

const focus = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
const plateLabel = 'font-mono text-xs uppercase tracking-wide text-accent';
const h2Class = 'font-display text-4xl leading-none font-normal md:text-5xl';
const grid = 'grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-5';
const btnPrimary = `inline-block bg-accent px-5 py-3.5 font-mono text-sm text-paper transition-colors hover:bg-accent-hover ${focus}`;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout title={copy.title} description={copy.description} locale={loc} currentPageKey="work" wide>
  <div class="bg-blueprint">
    <div class="mx-auto max-w-[1240px] px-6">
      <header class="flex flex-col gap-6 border-b-[1.5px] border-rule pt-14 pb-14 md:pt-[72px]">
        <p class={plateLabel}>{copy.plate}</p>
        <h1 class="m-0 text-[clamp(44px,7vw,92px)] leading-[0.96] font-normal tracking-[-0.025em]">
          {copy.h1Before}<em>{copy.h1Accent}</em>
        </h1>
        <p class="m-0 max-w-[640px] text-xl leading-snug text-text-muted">{copy.intro}</p>
      </header>

      {showcase.length === 0 && <p class="py-16 font-mono text-sm text-text-muted">{copy.empty}</p>}

      {
        highlighted.length > 0 && (
          <section
            id="highlighted"
            aria-labelledby="highlighted-title"
            class="flex flex-col gap-8 border-b-[1.5px] border-rule py-16"
          >
            <h2 id="highlighted-title" class={h2Class}>
              {copy.highlighted}
            </h2>
            <div class={grid}>
              {highlighted.map((p, i) => (
                <ShowcaseCard
                  project={p}
                  label={`A.${pad(i + 1)}`}
                  linkLabels={linkLabels}
                  caseStudy={caseStudyFor(p.title)}
                />
              ))}
            </div>
          </section>
        )
      }

      {
        more.length > 0 && (
          <section
            id="more"
            aria-labelledby="more-title"
            class="flex flex-col gap-8 border-b-[1.5px] border-rule py-16"
          >
            <h2 id="more-title" class={h2Class}>
              {copy.more}
            </h2>
            <div class={grid}>
              {more.map((p, i) => (
                <ShowcaseCard
                  project={p}
                  label={`A.${pad(highlighted.length + i + 1)}`}
                  linkLabels={linkLabels}
                  caseStudy={caseStudyFor(p.title)}
                />
              ))}
            </div>
          </section>
        )
      }

      {
        leftover.length > 0 && (
          <section
            id="case-studies"
            aria-labelledby="case-studies-title"
            class="flex flex-col gap-6 border-b-[1.5px] border-rule py-16"
          >
            <p class={plateLabel}>{copy.studiesPlate}</p>
            <h2 id="case-studies-title" class={h2Class}>
              {copy.studiesTitle}
            </h2>
            <ul class="m-0 flex list-none flex-col p-0">
              {leftover.map((s) => {
                const full = studies.find((x) => x.slug === s.slug);
                return (
                  <li class="border-t border-rule first:border-t-0">
                    <a
                      href={localizedPath('work', loc, s.slug)}
                      class={`flex flex-wrap items-baseline gap-x-4 gap-y-1 py-4 hover:text-accent ${focus}`}
                    >
                      <span class="text-2xl">{s.title}</span>
                      <span class="min-w-0 font-mono text-xs text-text-muted">{full?.tagline}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      <section
        id="contact"
        aria-labelledby="contact-title"
        class="flex flex-col items-start gap-5 py-[72px]"
      >
        <p class={plateLabel}>{copy.contactPlate}</p>
        <h2
          id="contact-title"
          class="font-display text-[clamp(40px,5.5vw,72px)] leading-[0.98] font-normal"
        >
          {copy.contactBefore}<em>{copy.contactAccent}</em>
        </h2>
        <a href={contactHref} data-cta="book-call" class={btnPrimary}>{copy.cta} →</a>
      </section>
    </div>
  </div>
</Layout>
