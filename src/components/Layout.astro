---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import { type Locale, type PageKey } from '../lib/i18n';
import { buildOgSlug, buildOgUrl, DEFAULT_OG_SLUG } from '../lib/og';
import {
  computeHreflangPair,
  X_DEFAULT_PATH,
  type HreflangPair,
  type PageDescriptor,
} from '../lib/hreflang';
import { findTranslation } from '../lib/translations';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /**
   * For static pages (home, about, work index, blog index, uses, contact)
   * pass the matching `PageKey` so Layout can compute hreflang alternates
   * via `localizedPath`. For collection entries (a blog post or a work case
   * study) leave this undefined and pass `currentDocId` + `currentCollection`
   * instead — Layout will resolve the sibling translation on its own.
   */
  currentPageKey?: PageKey;
  currentDocId?: string;
  currentCollection?: 'blog' | 'work';
}

const { title, description, locale, currentPageKey, currentDocId, currentCollection } = Astro.props;

// Resolve the OG image URL for this page. The slug MUST match the one the
// `src/pages/og/[...slug].png.ts` endpoint emits — `buildOgSlug` is the
// single source of truth for that convention.
//
// When the current page is a content entry (blog post or work case study),
// we derive the slug from `currentDocId` + `currentCollection`. Otherwise
// we fall back to the locale-aware default image (`/og/default/<loc>.png`),
// which the endpoint also prerenders.
//
// Under strictest TS, `Astro.site` is typed optional even though the project
// sets it in `astro.config.ts`. `buildOgUrl` returns `null` in that case and
// we skip the og:image tag rather than emit a relative URL — LinkedIn/Slack
// require absolute URLs for previews to render.
const ogSlug =
  currentDocId && currentCollection
    ? buildOgSlug({ id: currentDocId, collection: currentCollection, locale })
    : `${DEFAULT_OG_SLUG}/${locale}`;
const ogImageUrl = buildOgUrl(ogSlug, Astro.site);
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : null;
const ogImageAlt =
  locale === 'es' ? `Imagen de portada para: ${title}` : `Cover image for: ${title}`;

// Hreflang alternates.
//
// We lean on the shared descriptor type from `src/lib/hreflang.ts` so the
// pure branching logic (static vs collection, sibling-exists vs orphan) is
// unit-tested in isolation. Layout only wires up Astro-specific bits:
//   - reading the sibling slug via `findTranslation` / `getCollection` when
//     `currentDocId` + `currentCollection` are set
//   - converting the site-rooted path pair into absolute URLs with `Astro.site`
//
// Pages that don't pass any of the hreflang hints (e.g. one-off endpoints)
// simply get no alternates — the canonical link above still anchors SEO.
let hreflangPair: HreflangPair | null = null;

if (currentPageKey) {
  const descriptor: PageDescriptor = { kind: 'static', pageKey: currentPageKey };
  hreflangPair = computeHreflangPair(descriptor);
} else if (currentDocId && currentCollection) {
  // Collection entry: resolve the sibling via `findTranslation`. If the
  // current doc or its sibling is missing we emit NO hreflang (the orphan
  // case documented in the plan — a blind regex replace would 404).
  const all =
    currentCollection === 'blog' ? await getCollection('blog') : await getCollection('work');
  const current = all.find((d) => d.id === currentDocId);
  if (current) {
    const other: Locale = locale === 'es' ? 'en' : 'es';
    const sibling = findTranslation(current, all, other);
    const currentSlug = currentDocId.replace(`${locale}/`, '').replace(/\.mdx$/, '');
    const siblingSlug = sibling ? sibling.id.replace(`${other}/`, '').replace(/\.mdx$/, '') : null;
    hreflangPair = computeHreflangPair({
      kind: 'collection',
      collection: currentCollection,
      currentLocale: locale,
      currentSlug,
      siblingSlug,
    });
  }
}

const hreflangHref = (path: string): string | null =>
  Astro.site ? new URL(path, Astro.site).toString() : null;

const hreflangEsHref = hreflangPair ? hreflangHref(hreflangPair.es) : null;
const hreflangEnHref = hreflangPair ? hreflangHref(hreflangPair.en) : null;
const hreflangXDefaultHref = hreflangPair ? hreflangHref(X_DEFAULT_PATH) : null;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      hreflangEsHref && hreflangEnHref && hreflangXDefaultHref && (
        <>
          <link rel="alternate" hreflang="es" href={hreflangEsHref} />
          <link rel="alternate" hreflang="en" href={hreflangEnHref} />
          <link rel="alternate" hreflang="x-default" href={hreflangXDefaultHref} />
        </>
      )
    }
    <meta property="og:type" content={currentCollection === 'blog' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Facundo Pascale" />
    <meta property="og:locale" content={locale === 'es' ? 'es_AR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={ogImageAlt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      ogImageUrl && (
        <>
          <meta name="twitter:image" content={ogImageUrl} />
          <meta name="twitter:image:alt" content={ogImageAlt} />
        </>
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Facundo Pascale — Notas (ES)"
      href="/es/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Facundo Pascale — Writing (EN)"
      href="/en/rss.xml"
    />
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            document.documentElement.dataset.theme = 'light';
          }
        } catch {
          /* ignore: localStorage/matchMedia unavailable */
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header
      locale={locale}
      {...currentDocId !== undefined ? { currentDocId } : {}}
      {...currentCollection !== undefined ? { currentCollection } : {}}
    />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      (function () {
        try {
          if (sessionStorage.getItem('missing-translation') !== '1') return;
          sessionStorage.removeItem('missing-translation');
          const t = document.createElement('div');
          t.setAttribute('role', 'status');
          t.textContent =
            document.documentElement.lang === 'es'
              ? 'Esta página aún no está traducida.'
              : "This page isn't translated yet.";
          t.style.cssText =
            'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--color-bg-elevated);border:1px solid var(--color-accent);padding:10px 18px;font-family:var(--font-mono);font-size:12px;z-index:1000';
          document.body.appendChild(t);
          setTimeout(function () {
            t.remove();
          }, 4000);
        } catch {
          /* ignore: sessionStorage unavailable */
        }
      })();
    </script>
  </body>
</html>
