# Copy this file to .env.local and fill in real values.
# .env* is gitignored — never commit real secrets.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_placeholder

# Destination address for contact form submissions.
CONTACT_EMAIL_TO=hola@facundopascale.dev

# Vercel deploy hook URL — used by scheduled content revalidation.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/placeholder

# Shared secret used to authenticate cron requests hitting the deploy hook.
CRON_SECRET=generate-a-long-random-string

# Newsletter (double opt-in). Production only.
# Random string used to sign confirmation links, e.g. `openssl rand -hex 32`.
NEWSLETTER_SECRET=generate-a-long-random-string
# Resend segment ids, one per language (Resend dashboard > Segments).
RESEND_SEGMENT_ES=segment-id-es
RESEND_SEGMENT_EN=segment-id-en
# Optional: Resend topic id; confirmed contacts are opted in to it.
# RESEND_TOPIC_NEWSLETTER=topic-id
# Optional: sender (defaults to Facundo Pascale <newsletter@facundopascale.dev>).
# NEWSLETTER_FROM=
